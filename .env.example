# Copy to .env.local and adjust. Values here are the local-demo defaults.
DATABASE_URL=postgresql://postgres:***@127.0.0.1:5434/app_db
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# Preview-only switches — NEVER enable in production:
OTP_DEMO_MODE=true
OTP_DEMO_PHONES=09129998877,09121111111
PAYMENT_DEMO_MODE=true

# Versioned booking policy (customers' acceptance is recorded per version):
BOOKING_POLICY_VERSION=2.1

# Neshan (نشان) web-services key for the address search + static map in the
# admin «آدرس و نقشه» panel. Leave unset to disable search (manual entry works).
# The key stays server-side; the browser only talks to our /api/neshan/* proxy.
# NESHAN_API_KEY=

# Optional overrides (auto-generated per-DB when unset):
# SESSION_SECRET=
# OTP_SMS_WEBHOOK_URL=
# OTP_SMS_WEBHOOK_TOKEN=
# PAYMENT_WEBHOOK_SECRET=
