# NOTE: drizzle/ (migrations + journal) is intentionally TRACKED — committed
# migration files are the contract between environments; regenerating them per
# machine would produce diverging names/hashes and break `npm run db:migrate`.

# test artifacts
artifacts/
playwright-report/
test-results/
